		{
			"name": "4. Applications (تقديم الطلب ومتابعته)",
			"item": [
				{
					"name": "POST Public Apply (تقديم طلب التوظيف)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"var appId = jsonData.applicationId || (jsonData.data && jsonData.data.id);",
									"var trkId = jsonData.trackingId || (jsonData.data && jsonData.data.trackingId) || pm.response.headers.get(\"X-Tracking-ID\");",
									"if (appId) {",
									"    pm.collectionVariables.set(\"application_id\", appId);",
									"    console.log(\"Auto-saved application_id:\", appId);",
									"}",
									"if (trkId) {",
									"    pm.collectionVariables.set(\"tracking_id\", trkId);",
									"    console.log(\"Auto-saved tracking_id:\", trkId);",
									"}",
									"pm.test(\"Application Submitted Successfully - Status 201\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"candidateId\": {{candidate_id}},\n  \"jobId\": {{job_id}},\n  \"jobTitle\": \"Senior Java Backend Engineer\",\n  \"candidateEmail\": \"{{candidate_email}}\"\n}"
						},
